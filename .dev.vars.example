# No passcode: in prod Cloudflare Access is the gate. Locally (127.0.0.1 only)
# the browser is treated as this user.
DEV_LOCAL_EMAIL=dev@localhost
DREAM_API_TOKEN=dev-token-not-for-prod
ALLOW_SEED=true
DREAM_TZ=America/New_York
USDA_API_KEY=DEMO_KEY
# Optional. LLM may only parse text into items+quantities — never calories.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Wyze Scale X (worker secrets in prod — names only here, never commit values)
