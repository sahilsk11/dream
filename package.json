{
  "name": "dream",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Sahil's personal sleep / food / weight tracker",
  "scripts": {
    "dev": "npm run build:web && wrangler d1 migrations apply dream --local && wrangler dev --port 8787",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "npm run build:web",
    "start": "npm run dev",
    "seed": "wrangler d1 migrations apply dream --local && wrangler dev --port 8787",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.0.3",
    "wrangler": "^4.40.2"
  }
}
